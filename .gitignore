# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# GitReins sandbox (evaluation scratch space)
.gitreins-sandbox/
# GitReins guard history (runtime artifacts, no versioning needed)
.gitreins/history/
# Judge token-usage telemetry (PR #2 — best-effort cost log, never committed)
.gitreins/usage.jsonl
# Guard run logs (DF-018 — one full, untruncated log per guard run; runtime
# artifacts, pruned to the newest GUARD_LOG_KEEP runs)
.gitreins/logs/
# QA run ledger (gitreins qa — one row per QA run; runtime artifact. Point
# GITREINS_QA_LEDGER at a tracked path to version it.)
.gitreins/qa-ledger.jsonl
# Runtime task data (committed separately on gitreins branch)
.gitreins/tasks.yaml
# Dated backup strays a writer leaves beside a GitReins store (QA-GITREINS-POC-1
# residual: `.gitignore` covered the store but not `<store>.bak.<epoch>`).
.gitreins/tasks.yaml.bak.*
.gitreins/*.bak.*

# Secrets
.env
*.key
*.pem

# Test artifacts
.coverage
.skylos/
# Node (if present from bootstrap)
node_modules/
apps/
packages/
temporal-vector/
# Temp
test_write
*.tmp
*.db

# Cross-project artifacts (not part of GitReins)
category-mapping.yaml
hivemind-audit.md

# GitReins nested runtime artifacts
.gitreins/.gitreins/
.gitreins/worktrees.json
.gitreins/worktrees.lock
.gitreins/disposable.json
.gitreins/disposable.lock
.gitreins/config.yaml.bak

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm
# Graph-cache bookkeeping strays (QA-GITREINS-POC-9): the code-graph writer
# recreates these on every reconcile, so without an entry here every run
# re-dirties a clean tree with two untracked files. (.vfs/graph/edges.jsonl
# stays TRACKED on purpose — its refresh is a separate chore commit.)
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json

# Demo projects (own git repos, not part of GitReins source)
demo-calc/
demo-slugify/

# Board JSONL canonical store (5b6df60/JSONL-NORM-001) — cache binaries untracked; JSONL files are the tracked store

.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb
